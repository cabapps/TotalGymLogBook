{
  "name": "totalgymlogbook-client",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Vanilla web components and the instant-path logic for Total Gym Logbook. See docs/adr/0003.",
  "scripts": {
    "typecheck": "tsc --noEmit",
    "build": "esbuild src/main.ts --bundle --format=esm --minify --target=es2022 --outfile=../TotalGymLogBook.Web/wwwroot/dist/shell.js",
    "watch": "npm run build -- --watch",
    "test": "vitest run",
    "test:watch": "vitest",
    "check": "npm run typecheck && npm run test"
  },
  "devDependencies": {
    "@types/node": "^26.1.2",
    "esbuild": "^0.25.0",
    "fake-indexeddb": "^6.2.5",
    "typescript": "^5.7.0",
    "vitest": "^3.0.0"
  },
  "allowScripts": {
    "esbuild@0.25.12": true,
    "esbuild@0.28.1": true
  }
}
