@page "/program"
@using TotalGymLogBook.Domain.Training
@using TotalGymLogBook.Interop
@implements IDisposable
@inject ExerciseCatalog Catalog
@inject Logbook Logbook
@inject ProgramAnalyzer Analyzer

@*
    Whether the program the trainee is following is any good.

    The shell owns "what do I do next", because that drives the exercise picker and has to work
    before the .NET runtime exists (docs/adr/0003). This is the other half: the same per-muscle,
    fractional volume accounting the ledger uses, applied to a PLAN rather than to history --
    so a gap is visible before six weeks of running it, not after.
*@

<h2>Your program</h2>

@if (!_loaded)
{
    <p class="note">Reading your program&hellip;</p>
}
else if (_program is null)
{
    <p class="note" id="no-program">
        You're not following a program. That's a perfectly good way to train &mdash; the coach
        works from whatever you log. Pick one from the workout screen if you'd rather have the
        sessions laid out for you.
    </p>
}
else
{
    <p class="focus" id="program-name">@_program.Name</p>
    <p class="verdict @(_critique.Warnings.Count == 0 ? "ok" : "gap")" id="program-verdict">
        @_critique.Verdict
    </p>

    @if (_critique.EmphasisNote.Length > 0)
    {
        <p class="note small" id="program-emphasis">@_critique.EmphasisNote</p>
    }

    @if (_critique.Warnings.Count > 0)
    {
        <ul class="warnings" id="program-warnings">
            @foreach (var warning in _critique.Warnings)
            {
                <li>@warning</li>
            }
        </ul>
    }

    @if (_critique.Untrained.Length > 0)
    {
        <p class="note small" id="program-untrained">@_critique.Untrained</p>
    }

    @* The same chart the history tab draws, against the same line -- one is what this program
       would give you, the other is what the week actually did. *@
    <h2>Sets a rotation</h2>
    <div class="chart-wrap" id="program-volume">
        <div class="bars" style="--target: @Pct(_volume.TargetPercent / 100)">
            @foreach (var bar in _volume.Bars)
            {
                <div class="bar-row">
                    <span class="bar-label">@bar.Label</span>
                    <span class="track">
                        <span class="fill @(bar.Short ? "short" : "")"
                              style="width: @Pct(_volume.WidthPercent(bar))%"></span>
                    </span>
                    <span class="bar-value">@bar.Detail</span>
                </div>
            }
            <span class="goal-line" aria-hidden="true"></span>
        </div>
        <div class="legend">
            <span class="k goal"></span>
            <text>the goal: @_volume.TargetLabel a rotation, where growth starts</text>
        </div>
        <p class="note small">
            One rotation through @_program.Sessions.Count session@(_program.Sessions.Count == 1 ? "" : "s"),
            counted the same way as your logged volume &mdash; a movement's secondary muscles get
            half a set each.
        </p>
    </div>

    <h2>Sessions</h2>
    <ol class="sessions" id="program-sessions">
        @foreach (var session in _program.Sessions)
        {
            <li>
                <strong>@session.Name</strong>
                <span class="sub">
                    @string.Join(", ", session.Exercises.Select(e => $"{Catalog.NameOf(e.ExerciseId)} ×{e.Sets}"))
                </span>
            </li>
        }
    </ol>
}

<style>
    .verdict { font-size: var(--text-subhead); line-height: 1.5; margin: 0 0 .6rem;
               padding: var(--card-pad-y) var(--gutter); border-radius: var(--radius-card);
               background: var(--surface); }
    .verdict.gap { background: var(--surface-warn); }
    .note.small { font-size: var(--text-footnote); color: var(--muted); margin: 0 0 .5rem;
                  line-height: 1.45; }
    ul.warnings { list-style: none; margin: 0 0 .5rem; padding: 0;
                  font-size: var(--text-footnote); color: var(--muted); }
    ul.warnings li { padding: .25rem 0; }
    ol.sessions { list-style: none; margin: 0; padding: 0; }
    ol.sessions li { padding: .55rem 0; border-top: var(--hairline) solid var(--separator);
                     font-size: var(--text-subhead); }
    ol.sessions li:first-child { border-top: 0; }
    ol.sessions .sub { display: block; color: var(--muted); font-size: var(--text-footnote);
                       margin-top: .15rem; }
</style>

@code {
    private bool _loaded;
    private TrainingProgram? _program;
    private ProgramCritique _critique = new([], [], "", "");
    private WeeklyProgress _volume = WeeklyProgress.Nothing;

    protected override async Task OnInitializedAsync()
    {
        Logbook.Changed += OnChanged;
        await LoadAsync();
    }

    private void OnChanged() => _ = InvokeAsync(async () =>
    {
        await LoadAsync();
        StateHasChanged();
    });

    private async Task LoadAsync()
    {
        _program = await Logbook.GetActiveProgramAsync();

        if (_program is not null)
        {
            var phase = await Logbook.GetPhaseAsync(DateOnly.FromDateTime(DateTime.Now));
            var experience = await Logbook.GetExperienceAsync();
            var goal = await Logbook.GetGoalAsync();
            var settings = await Logbook.GetSettingsAsync();

            // The OBSERVED balance belongs here rather than in the shell. Whether the trainee is
            // in a deficit is a phase call, and docs/adr/0010 puts phase calls in C# — so the
            // builder ranks by what they said, and the coach is what notices they have been
            // losing weight since.
            var emphasis = ProgramEmphasisRules.For(
                ProgramEmphasisRules.ParseAim(settings.Aim, goal.Primary), phase.Balance);

            var target = VolumeTarget.For(experience, phase.Balance);

            _critique = Analyzer.Critique(_program, Catalog, target, emphasis);
            _volume = WeeklyProgressReport.ForPlan(_critique.Volumes, target);
        }

        _loaded = true;
    }

    /// <summary>Percentages, invariant-cultured, because a comma decimal is not valid CSS.</summary>
    private static string Pct(double value) =>
        value.ToString("0.##", System.Globalization.CultureInfo.InvariantCulture);

    public void Dispose() => Logbook.Changed -= OnChanged;
}
