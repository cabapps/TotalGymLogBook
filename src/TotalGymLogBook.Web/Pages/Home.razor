@page "/"
@using TotalGymLogBook.Domain
@using TotalGymLogBook.Domain.Training
@using TotalGymLogBook.Interop
@implements IDisposable
@inject RailProfileTable Profiles
@inject Logbook Logbook
@inject ProgressionEngine Engine

@*
    The derived tier (docs/adr/0003). Everything here reads sets that TypeScript wrote to
    IndexedDB, through the read-only bridge -- Blazor never opens the database itself.

    The shell above is fully usable before any of this exists. That is the architectural bet.
*@

<h2>Your next set <span class="tag">derived tier &middot; .NET</span></h2>

@if (!_loaded)
{
    <p class="note">Reading your logbook&hellip;</p>
}
else if (_recommendation is null)
{
    <p class="note" id="empty-state">
        No sets logged yet. Once you log a few, the coach works out what to do next from your
        own history &mdash; level, added weight, reps, and how your bodyweight is moving.
    </p>
}
else
{
    <div class="rec">
        <div class="rec-load" id="rec-load">@_recommendation.TargetLb.ToString("0.#")<small>lb</small></div>
        <div class="rec-setup">
            Level @_recommendation.Level
            @if (_recommendation.AddedLb > 0)
            {
                <text> &middot; +@_recommendation.AddedLb.ToString("0.#") lb added</text>
            }
            &middot; @_recommendation.Sets &times; @_recommendation.TargetReps reps
        </div>
        <p class="rec-why" id="rec-why">@_recommendation.Rationale</p>
    </div>

    <dl class="facts">
        <dt>Logged</dt><dd id="fact-logged">@_setCount sets across @_exerciseCount exercise(s)</dd>
        <dt>Weight</dt><dd>@_phaseNote</dd>
        <dt>Machine</dt><dd>@_profileLabel</dd>
    </dl>
}

<style>
    /* Slotted into the app shell, which already supplies the 34rem column and the side
       padding. Adding our own would double it. */
    .tg-derived { margin: 0; padding: 0; }
    .tg-derived h2 { font-size: 1.05rem; margin: 1.25rem 0 .5rem; }
    .tag {
        display: inline-block; font-size: .6875rem; letter-spacing: .04em; text-transform: uppercase;
        background: #6b7280; color: #fff; border-radius: 999px; padding: .15rem .5rem;
        vertical-align: middle;
    }
    .tg-derived .note { color: var(--muted); font-size: .8125rem; }
    .rec {
        background: var(--surface); border: 1px solid var(--border);
        border-radius: .75rem; padding: 1rem;
    }
    .rec-load { font-size: 2.25rem; font-weight: 650; line-height: 1; font-variant-numeric: tabular-nums; }
    .rec-load small { font-size: .9rem; font-weight: 400; color: var(--muted); margin-left: .25rem; }
    .rec-setup { margin-top: .35rem; font-size: .9rem; }
    .rec-why { margin: .75rem 0 0; font-size: .85rem; color: var(--muted); line-height: 1.45; }
    .facts { display: grid; grid-template-columns: auto 1fr; gap: .3rem .75rem; margin-top: 1rem;
             font-size: .8125rem; }
    .facts dt { color: var(--muted); }
    .facts dd { margin: 0; }
</style>

@code {
    private const string PreferredExercise = "chest-press";

    private bool _loaded;
    private Recommendation? _recommendation;
    private int _setCount;
    private int _exerciseCount;
    private string _phaseNote = "";
    private string _profileLabel = "";

    protected override async Task OnInitializedAsync()
    {
        Logbook.Changed += OnLogbookChanged;
        await LoadAsync();
    }

    private void OnLogbookChanged() =>
        // Fired from the JS change bus, so hop back onto the renderer's context.
        _ = InvokeAsync(async () =>
        {
            await LoadAsync();
            StateHasChanged();
        });

    private async Task LoadAsync()
    {
        var today = DateOnly.FromDateTime(DateTime.UtcNow);

        var histories = await Logbook.GetHistoriesAsync();
        var profile = await Logbook.GetRailProfileAsync();
        var goal = await Logbook.GetGoalAsync();
        var phase = await Logbook.GetPhaseAsync(today);
        var trend = await Logbook.GetBodyweightTrendAsync();

        _setCount = histories.Sum(h => h.Sets.Count);
        _exerciseCount = histories.Count;
        _profileLabel = $"{profile.LevelCount}-notch rail, {profile.BoardWeightLb:0.#} lb glideboard";
        _phaseNote = trend.HasAny ? trend.Describe(today) : "No weigh-ins yet.";

        var history = histories.FirstOrDefault(h => h.ExerciseId == PreferredExercise)
                      ?? histories.FirstOrDefault();

        if (history is not null && history.Sets.Count > 0)
        {
            var bodyweight = trend.SmoothedLb ?? 180;

            // The ladder must describe the SAME exercise the sets were logged against. A cable
            // movement is halved by the pulley, so building a default ladder here would compare
            // 28.4 lb of chest press against a 61.4 lb direct-press rung and recommend doubling
            // the load. Both figures come from the frozen snapshot (docs/adr/0004).
            var last = history.LastSession[0];
            var ladder = new LoadLadder(
                profile, bodyweight, EquipmentInventory.None,
                usesPulley: last.UsesPulley,
                bodyFraction: last.BodyFraction);

            _recommendation = Engine.NextSession(history, goal, phase, ladder);
        }
        else
        {
            _recommendation = null;
        }

        _loaded = true;
    }

    public void Dispose() => Logbook.Changed -= OnLogbookChanged;
}
