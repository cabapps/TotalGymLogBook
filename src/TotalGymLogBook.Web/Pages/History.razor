@page "/history"
@using TotalGymLogBook.Domain
@using TotalGymLogBook.Domain.Persistence
@using TotalGymLogBook.Domain.Training
@using TotalGymLogBook.Interop
@implements IDisposable
@inject Logbook Logbook
@inject ExerciseCatalog Catalog

@*
    History lives in Blazor because it is entirely derived: grouping, per-muscle rollups, trend
    lines. That is the "complicated work that wants the .NET runtime" side of docs/adr/0003, and
    it can arrive late without anyone minding.
*@

<h2>History</h2>

@if (!_loaded)
{
    <p class="note">Reading your logbook&hellip;</p>
}
else if (_sessions.Count == 0)
{
    <p class="note" id="history-empty">
        No workouts recorded yet. Log a set and it will show up here.
    </p>
}
else
{
    <p class="note" id="history-summary">
        @_sessions.Count session@(_sessions.Count == 1 ? "" : "s") &middot;
        @_totalSets set@(_totalSets == 1 ? "" : "s") &middot;
        @_setsPerMuscle.ToString("0.#") sets per muscle a week
    </p>

    @* What the week actually delivered, against whatever the trainee's program is for.
       Hand-rolled -- a chart library would be a CDN dependency the CSP blocks anyway. *@
    @if (_progress.Bars.Count > 0)
    {
        <h2>@(_progress.Yardstick == ProgressYardstick.ProgramGoal ? "This rotation" : "This week")</h2>

        <div class="chart-wrap" id="history-chart">
            <div class="bars" style="--target: @Pct(_progress.TargetPercent / 100)">
                @foreach (var bar in _progress.Bars)
                {
                    <div class="bar-row">
                        <span class="bar-label">@bar.Label</span>
                        <span class="track">
                            <span class="fill @(bar.Short ? "short" : "")"
                                  style="width: @Pct(_progress.WidthPercent(bar))%"></span>
                        </span>
                        <span class="bar-value">@bar.Detail</span>
                    </div>

                    @* Only where the sides have drifted apart -- see WeeklyProgressReport.SplitOf. *@
                    @foreach (var side in bar.Sides)
                    {
                        <div class="bar-row side">
                            <span class="bar-label">@side.Label</span>
                            <span class="track">
                                <span class="fill @(side.Short ? "short" : "")"
                                      style="width: @Pct(_progress.WidthPercent(side))%"></span>
                            </span>
                            <span class="bar-value">@side.Detail</span>
                        </div>
                    }
                }
                @if (_progress.HasTarget)
                {
                    <span class="goal-line" aria-hidden="true"></span>
                }
            </div>

            @if (_progress.HasTarget)
            {
                <div class="legend">
                    <span class="k goal"></span>
                    <text>the goal: @_progress.TargetLabel</text>
                </div>
            }

            <p class="note small" id="history-goal">@_progress.Headline</p>
            @if (_trendNote.Length > 0)
            {
                <p class="note small" id="history-trend">@_trendNote</p>
            }
        </div>
    }

    <ul class="sessions">
        @foreach (var s in _sessions)
        {
            <li>
                <div class="row">
                    <div class="when">
                        <strong>@s.When.ToString("ddd d MMM")</strong>
                        <span class="sub">@s.When.ToString("HH:mm") &middot; @s.Sets sets &middot; @s.Trained</span>
                    </div>
                    <button class="del" id="del-@s.Id" @onclick="() => Delete(s)">Delete</button>
                </div>
                <div class="exercises">@s.Summary</div>
            </li>
        }
    </ul>
}

<style>
    /* The list is the card: rows on white, hairlines between, nothing drawn around it. */
    ul.sessions {
        list-style: none; margin: 0; padding: 0 var(--gutter);
        background: var(--surface); border-radius: var(--radius-card);
    }
    ul.sessions li { padding: .7rem 0; border-top: var(--hairline) solid var(--separator); }
    ul.sessions li:first-child { border-top: 0; }
    .row { display: flex; align-items: center; justify-content: space-between; gap: .5rem; }
    .when strong { font-size: var(--text-body); }
    .when .sub { display: block; color: var(--muted); font-size: var(--text-footnote); }
    .exercises { color: var(--muted); font-size: var(--text-footnote); margin-top: .2rem; }
    button.del {
        font: inherit; min-width: 2rem; min-height: 2rem; padding: 0 .6rem;
        border: 0; border-radius: var(--radius-small);
        background: var(--fill); color: var(--danger);
        font-size: var(--text-subhead); cursor: pointer;
        -webkit-tap-highlight-color: transparent;
    }
</style>

@code {
    private sealed record Row(string Id, DateTime When, int Sets, string Trained, string Summary);

    /// <summary>
    /// Points of the load/bodyweight comparison. The chart is gone -- it answered a question
    /// ("is my top set going up?") that the coach already answers per exercise, on the screen
    /// where the trainee is about to do that exercise. The READING survives as a sentence,
    /// because it is the one thing nobody works out for themselves: on this machine, load
    /// falling while bodyweight falls is maintained strength, not lost strength (docs/adr/0004).
    /// </summary>
    private sealed record Trend(
        IReadOnlyList<(DateOnly On, double Load, double? Bw)> Points, bool HasBodyweight)
    {
        public static readonly Trend Empty = new([], false);
    }

    private bool _loaded;
    private List<Row> _sessions = [];
    private int _totalSets;

    /// <summary>
    /// Average weekly sets per muscle group actually trained.
    ///
    /// This replaced total tonnage, which was a number nobody can act on: lifted pounds are not
    /// comparable across exercises — one heavy calf raise outweighs every curl you will ever do —
    /// so the total tracked exercise selection more than effort, and a session could look bigger
    /// for being easier. Sets per muscle is the unit the coach programs in (docs/adr/0010), so
    /// this figure and the one the coach quotes are now the same figure.
    /// </summary>
    private double _setsPerMuscle;
    private WeeklyProgress _progress = WeeklyProgress.Nothing;
    private string _trendNote = "";

    protected override async Task OnInitializedAsync()
    {
        Logbook.Changed += OnChanged;
        await LoadAsync();
    }

    private void OnChanged() => _ = InvokeAsync(async () => { await LoadAsync(); StateHasChanged(); });

    private async Task LoadAsync()
    {
        var history = await Logbook.GetSessionHistoryAsync();
        var trend = await Logbook.GetBodyweightTrendAsync();

        _progress = await BuildProgressAsync(history);

        _sessions = history
            .Where(h => h.Sets.Count > 0)
            .Select(h =>
            {
                var when = DateTimeOffset.FromUnixTimeMilliseconds(h.Session.StartedAt).LocalDateTime;
                var names = h.Sets.Select(s => s.ExerciseId).Distinct().ToList();

                return new Row(h.Session.Id, when, h.Sets.Count, TrainedIn(h.Sets),
                    string.Join(", ", names.Select(Pretty)));
            })
            .OrderByDescending(r => r.When)
            .ToList();

        _totalSets = _sessions.Sum(r => r.Sets);
        _setsPerMuscle = WeeklySetsPerMuscle(history);
        _trendNote = Describe(BuildTrend(history, trend));
        _loaded = true;
    }

    /// <summary>
    /// The week against whatever the trainee's program is actually for.
    ///
    /// Everything the decision needs already exists: the ledger counts sets per muscle the same
    /// way the coach does, the aim says what they are training for, and the program says what it
    /// planned. This assembles them and hands the answer to <see cref="WeeklyProgressReport"/>,
    /// which owns the choice of yardstick so the history tab and the program tab cannot end up
    /// making different claims about the same week.
    /// </summary>
    private async Task<WeeklyProgress> BuildProgressAsync(IReadOnlyList<SessionWithSetsDto> history)
    {
        var today = DateOnly.FromDateTime(DateTime.Now);

        var histories = await Logbook.GetHistoriesAsync();
        var settings = await Logbook.GetSettingsAsync();
        var goal = await Logbook.GetGoalAsync();
        var phase = await Logbook.GetPhaseAsync(today);
        var experience = await Logbook.GetExperienceAsync();
        var program = await Logbook.GetActiveProgramAsync();

        var logged = history
            .Where(h => h.Sets.Count > 0)
            .Select(h => new LoggedSession(
                h.Session.ProgramSessionId,
                DateOnly.FromDateTime(
                    DateTimeOffset.FromUnixTimeMilliseconds(h.Session.StartedAt).LocalDateTime),
                h.Sets.Count))
            .ToList();

        return WeeklyProgressReport.For(
            ProgramEmphasisRules.ParseAim(settings.Aim, goal.Primary),
            new VolumeLedger(histories, Catalog.ById),
            VolumeTarget.For(experience, phase.Balance),
            program,
            logged,
            Catalog,
            today);
    }

    /// <summary>Percentages, invariant-cultured, because a comma decimal is not valid CSS.</summary>
    private static string Pct(double value) =>
        value.ToString("0.##", System.Globalization.CultureInfo.InvariantCulture);

    /// <summary>The muscles a session actually worked, biggest share first.</summary>
    private string TrainedIn(IReadOnlyList<SetLogDto> sets)
    {
        var perMuscle = new Dictionary<MuscleGroup, double>();

        foreach (var set in sets)
        {
            if (Catalog.TryGet(set.ExerciseId) is not { CountsAsVolume: true } exercise) continue;
            foreach (var involvement in exercise.Muscles)
            {
                perMuscle[involvement.Muscle] =
                    perMuscle.GetValueOrDefault(involvement.Muscle) + involvement.Fraction;
            }
        }

        return perMuscle.Count == 0
            ? "no working sets"
            : string.Join(", ", perMuscle
                .Where(kv => kv.Value >= 1)
                .OrderByDescending(kv => kv.Value)
                .Take(3)
                .Select(kv => kv.Key.Label()));
    }

    /// <summary>
    /// Average weekly sets per muscle across everything logged, counting only muscles that have
    /// been trained at all. A muscle the trainee never works would otherwise drag the figure down
    /// forever and make every week look like a bad one.
    /// </summary>
    private double WeeklySetsPerMuscle(IReadOnlyList<SessionWithSetsDto> history)
    {
        var sets = history.SelectMany(h => h.Sets).ToList();
        if (sets.Count == 0) return 0;

        var perMuscle = new Dictionary<MuscleGroup, double>();
        foreach (var set in sets)
        {
            if (Catalog.TryGet(set.ExerciseId) is not { CountsAsVolume: true } exercise) continue;
            foreach (var involvement in exercise.Muscles)
            {
                perMuscle[involvement.Muscle] =
                    perMuscle.GetValueOrDefault(involvement.Muscle) + involvement.Fraction;
            }
        }

        if (perMuscle.Count == 0) return 0;

        var days = history
            .Select(h => DateTimeOffset.FromUnixTimeMilliseconds(h.Session.StartedAt).Date)
            .Distinct()
            .Count();
        var weeks = Math.Max(1.0, days / 7.0);

        return perMuscle.Values.Average() / weeks;
    }

    /// <summary>Top working set per day, paired with the nearest weigh-in.</summary>
    private static Trend BuildTrend(IReadOnlyList<SessionWithSetsDto> history, BodyweightTrend trend)
    {
        var byDay = history
            .SelectMany(h => h.Sets)
            .Where(s => s.DeletedAt is null)
            .GroupBy(s => s.On)
            .Where(g => DateOnly.TryParse(g.Key, out _))
            .Select(g => (On: DateOnly.Parse(g.Key), Load: g.Max(s => s.ComputedLb)))
            .OrderBy(p => p.On)
            .ToList();

        if (byDay.Count < 2) return Trend.Empty;

        var readings = trend.HasAny ? trend : null;
        var points = byDay
            .Select(p => (p.On, p.Load, Bw: BodyweightNear(readings, p.On)))
            .ToList();

        return new Trend(points, points.Count(p => p.Bw is not null) > 1);
    }

    /// <summary>Nearest weigh-in within a week; bodyweight is not recorded every training day.</summary>
    private static double? BodyweightNear(BodyweightTrend? trend, DateOnly on)
    {
        if (trend is null || !trend.HasAny) return null;

        var readings = trend.Readings
            .Where(r => Math.Abs(r.On.DayNumber - on.DayNumber) <= 7)
            .OrderBy(r => Math.Abs(r.On.DayNumber - on.DayNumber))
            .ToList();

        return readings.Count > 0 ? readings[0].Lb : null;
    }

    /// <summary>
    /// The reading that matters, in plain language. docs/adr/0004: load falling while
    /// bodyweight falls is maintained strength, not regression.
    /// </summary>
    private static string Describe(Trend chart)
    {
        if (chart.Points.Count < 2) return "";

        var first = chart.Points[0];
        var last = chart.Points[^1];
        var loadDelta = last.Load - first.Load;

        if (!chart.HasBodyweight || first.Bw is null || last.Bw is null)
        {
            return loadDelta >= 0
                ? $"Top set is up {loadDelta:0.#} lb since you started logging."
                : $"Top set is down {Math.Abs(loadDelta):0.#} lb. Weigh in regularly and the coach can tell you whether that is bodyweight or strength.";
        }

        var bwDelta = last.Bw.Value - first.Bw.Value;

        return (loadDelta, bwDelta) switch
        {
            ( >= 0, <= -1) => $"Your top set held or rose while you lost {Math.Abs(bwDelta):0.#} lb. That is the win.",
            ( < 0, <= -1) => $"Top set is down {Math.Abs(loadDelta):0.#} lb, but so is your bodyweight, by {Math.Abs(bwDelta):0.#} lb. On this machine that is expected, not lost strength.",
            ( > 0, >= 1) => $"Top set is up {loadDelta:0.#} lb and you are {bwDelta:0.#} lb heavier, so some of that is the extra bodyweight.",
            _ => $"Top set has moved {loadDelta:+0.#;-0.#;0} lb with your weight steady, so that is a real change.",
        };
    }

    private static string Pretty(string exerciseId) =>
        string.Join(' ', exerciseId.Split('-').Select(w => char.ToUpperInvariant(w[0]) + w[1..]));

    private async Task Delete(Row row)
    {
        await Logbook.DeleteSessionAsync(row.Id);
        await LoadAsync();
        StateHasChanged();
    }

    public void Dispose() => Logbook.Changed -= OnChanged;
}
