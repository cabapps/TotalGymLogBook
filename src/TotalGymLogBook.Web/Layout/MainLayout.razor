@inherits LayoutComponentBase

@* docs/adr/0003: Blazor owns only the region inside #blazor-root. Navigation, the tab bar,
   and the set logger are web components living outside it. That root is slotted into
   <tg-app-shell> (see index.html), so everything below inherits the shell's column width. *@
<article class="tg-derived">
    <nav class="tg-nav">
        <NavLink href="" Match="NavLinkMatch.All">Coach</NavLink>
        <NavLink href="program">Program</NavLink>
        <NavLink href="history">History</NavLink>
    </nav>
    @Body
</article>

<style>
    /* Typography shared by every derived view.

       It lives in the LAYOUT rather than in the pages because Blazor removes a page's style
       block along with its markup when you navigate away: the same rules written in Home.razor
       styled the coach and then silently stopped applying to History, so one heading was an
       iOS section header and the identical heading one tap away was a browser default h2.

       (Razor parses HTML tags inside CSS comments too, so do not name that element here --
       an unclosed one fails the build with a message that points at this line.) */
    .tg-derived { margin: 0; padding: 0; }
    .tg-derived h2 {
        font-size: var(--text-footnote); font-weight: 400; letter-spacing: .04em;
        text-transform: uppercase; color: var(--muted);
        margin: 1.5rem var(--gutter) .4rem;
    }
    .tg-derived .note { color: var(--muted); font-size: var(--text-subhead); line-height: 1.45; }

    /* The progress chart, shared by the history tab and the program tab.

       In the LAYOUT because both pages draw it and a page's style block is removed with its
       markup on navigation -- the same trap the headings above are here to avoid. It is also the
       point: the two charts answer the same question about a logged week and a planned one, so
       they have to look like the same chart. */
    .chart-wrap {
        background: var(--surface); border-radius: var(--radius-card);
        padding: var(--card-pad-y) var(--gutter); margin: 0 0 1rem;
    }
    /* The bars and the goal line share one coordinate space: every bar is a share of its own
       target, so the line can sit at a single --target fraction across all of them. */
    .bars { position: relative; }
    .bar-row { display: flex; align-items: center; gap: .5rem; padding: .28rem 0;
               font-size: var(--text-footnote); }
    .bar-label { flex: 0 0 5.5rem; }
    .track { position: relative; flex: 1; height: .5rem; border-radius: 999px;
             background: var(--fill-strong); overflow: hidden; }
    .fill { display: block; height: 100%; border-radius: 999px; background: var(--accent); }
    /* Short of the goal is a state to notice, not a failure. */
    .fill.short { background: var(--system-orange); }
    .bar-value { flex: 0 0 4.5rem; text-align: right; color: var(--muted);
                 font-variant-numeric: tabular-nums; }
    /* Spans the track column only. The insets are the row's own geometry: 5.5rem of label plus
       a .5rem gap in front, a .5rem gap and 4.5rem of value behind. --target is a fraction, not
       a percentage, because calc cannot divide one percentage by another. */
    .goal-line { position: absolute; top: 0; bottom: 0; pointer-events: none;
                 left: calc(6rem + (100% - 11rem) * var(--target));
                 border-left: 2px dashed var(--fg); opacity: .45; }
    .legend { font-size: var(--text-caption); color: var(--muted); margin-top: .5rem;
              display: flex; align-items: center; gap: .35rem; flex-wrap: wrap; }
    .legend .k { display: inline-block; width: .8rem; height: 0; border-top: 2px dashed var(--fg);
                 opacity: .45; }
    .tg-derived .note.small { font-size: var(--text-footnote); margin-top: .35rem; }

    /* A segmented control: one gray trough, equal segments, and a white "thumb" that lands on
       the selected one. It is the standard iOS way to switch between peer views of the same
       data, which is exactly what Coach / Program / History are.

       It also still marks the seam between the instant tier and the derived tier -- the whole
       control appears when Blazor arrives, which doubles as the "the coach is here now" cue. */
    .tg-nav {
        display: flex; gap: .125rem; margin: 1.75rem 0 1rem;
        padding: .125rem; border-radius: .5625rem;
        background: var(--fill);
    }
    .tg-nav a {
        flex: 1; text-align: center;
        display: flex; align-items: center; justify-content: center;
        min-height: 2rem; padding: 0 .5rem; border-radius: .4375rem;
        font-size: var(--text-footnote); font-weight: 500;
        color: var(--fg); text-decoration: none;
        -webkit-tap-highlight-color: transparent;
    }
    .tg-nav a.active {
        background: var(--segment-thumb); font-weight: 600;
        box-shadow: 0 .1875rem .5rem rgb(0 0 0 / .12), 0 .0625rem .0625rem rgb(0 0 0 / .04);
    }
</style>
